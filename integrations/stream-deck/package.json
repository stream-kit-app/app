{
	"name": "@stream-kit/streamdeck-plugin",
	"version": "0.1.0-alpha.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "node scripts/generate-icons.mjs",
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart app.stream-kit.streamdeck\"",
		"link": "streamdeck link app.stream-kit.streamdeck.sdPlugin",
		"restart": "streamdeck restart app.stream-kit.streamdeck",
		"icons": "node scripts/generate-icons.mjs",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.1",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^26.6.4",
		"@types/ws": "^8.18.2",
		"rollup": "^4.64.0",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3"
	}
}
