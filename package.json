{
	"name": "@stream-kit/workspace",
	"private": true,
	"version": "0.1.0-alpha.0",
	"packageManager": "pnpm@10.34.6",
	"type": "module",
	"scripts": {
		"changeset": "changeset",
		"version-packages": "node scripts/version-packages.mjs",
		"release": "node scripts/release.mjs",
		"bootstrap": "node scripts/dev-bootstrap.mjs",
		"codegen": "node scripts/generate-script-api-types.mjs",
		"build:packages": "turbo run build --filter=@stream-kit/core --filter=@stream-kit/plugin --filter=@stream-kit/ui --filter=@stream-kit/plugin-* --filter=!@stream-kit/plugin-template && turbo run build:plugin-host --filter=@stream-kit/app",
		"dev": "node scripts/ensure-plugin-builds.mjs && turbo run dev --filter=@stream-kit/app --filter=@stream-kit/site --filter=@stream-kit/pocketbase --filter=@stream-kit/core --filter=@stream-kit/plugin --filter=@stream-kit/plugin-* --filter=!@stream-kit/plugin-template",
		"dev:all": "node scripts/ensure-plugin-builds.mjs && turbo run dev --filter=@stream-kit/app --filter=@stream-kit/site --filter=@stream-kit/pocketbase --filter=@stream-kit/docs --filter=@stream-kit/core --filter=@stream-kit/plugin --filter=@stream-kit/ui --filter=@stream-kit/plugin-* --filter=!@stream-kit/plugin-template",
		"dev:packages": "turbo run dev --filter=@stream-kit/core --filter=@stream-kit/plugin --filter=@stream-kit/ui --filter=@stream-kit/plugin-* --filter=!@stream-kit/plugin-template",
		"dev:app": "turbo run dev --filter=@stream-kit/app --filter=@stream-kit/pocketbase",
		"dev:site": "turbo run dev --filter=@stream-kit/site --filter=@stream-kit/pocketbase",
		"build:site": "pnpm --filter @stream-kit/core build && pnpm --filter @stream-kit/site build",
		"preview:site": "pnpm --filter @stream-kit/site preview",
		"generate:docs-reference": "node scripts/generate-docs-reference.mjs",
		"generate:script-api-types": "node scripts/generate-script-api-types.mjs",
		"dev:docs": "turbo run dev --filter=@stream-kit/docs",
		"build:docs": "pnpm --filter @stream-kit/docs build",
		"preview:docs": "pnpm --filter @stream-kit/docs preview",
		"build": "pnpm build:packages && pnpm --filter @stream-kit/app build",
		"package:plugins": "node scripts/package-plugin.mjs --all",
		"publish:plugins": "node scripts/publish-plugin-distribution.mjs --all",
		"publish:npm": "pnpm -r --filter @stream-kit/core --filter @stream-kit/plugin --filter @stream-kit/ui publish --access public --no-git-checks",
		"create:plugin-repos": "node scripts/create-plugin-repos.mjs",
		"create:plugin-starter-repo": "node scripts/create-plugin-starter-repo.mjs",
		"sync:plugin-starter": "node scripts/sync-plugin-starter.mjs",
		"preview": "pnpm --filter @stream-kit/app preview",
		"check": "pnpm build:packages && pnpm -r check",
		"tauri": "pnpm --filter @stream-kit/app tauri",
		"lint": "prettier --check . && pnpm --filter @stream-kit/app lint",
		"format": "prettier --write ."
	},
	"license": "SEE LICENSE IN LICENSE",
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"concurrently": "^10.0.5",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"turbo": "2.11.7",
		"vite-plugin-node-polyfills": "^0.28.0"
	}
}
