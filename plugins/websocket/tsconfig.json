{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@stream-kit/plugin": ["../../packages/plugin/dist/index.d.ts"],
			"@stream-kit/plugin/action": ["../../packages/plugin/stubs/action.d.ts"],
			"@stream-kit/plugin/utils": ["../../packages/plugin/stubs/utils.d.ts"],
			"@stream-kit/ui/*": ["../../packages/ui/src/lib/*"],
			"$lib/*": ["../../packages/app/src/lib/*"],
			"$db/*": ["../../packages/app/src/db/*"],
			"$app/env/public": ["../../packages/plugin/stubs/app-env-public.ts"],
			"$app/env": ["../../packages/plugin/stubs/app-env.ts"]
		}
	},
	"include": [
		"src",
		"../../packages/plugin/stubs/action-ui.d.ts",
		"../../packages/plugin/stubs/runtime.d.ts",
		"../../packages/ui/src/vite-env.d.ts"
	]
}
