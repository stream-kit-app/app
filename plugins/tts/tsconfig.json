{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@stream-kit/app/api": ["../../packages/core/dist/index.d.ts"],
			"$db/*": ["../../packages/app/src/db/*"],
			"$lib/*": ["../../packages/app/src/lib/*"]
		}
	},
	"include": ["src", "src/**/*.d.ts"]
}
