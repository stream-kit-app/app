{
  "name": "@stream-kit/docs",
  "version": "0.0.1-alpha.0",
  "private": true,
  "scripts": {
    "prebuild": "node ../scripts/generate-docs-reference.mjs && fumadocs-mdx",
    "build": "next build",
    "dev": "next dev",
    "preview": "serve out",
    "start": "serve out",
    "deploy": "pnpm build && wrangler pages deploy out --project-name=stream-kit-docs",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "cnfast": "^0.2.0",
    "fumadocs-core": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.15.18",
    "lucide-react": "^1.50.0",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zbsearch": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wrangler": "4.147.0"
  }
}