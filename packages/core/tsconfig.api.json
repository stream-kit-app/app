{
	"extends": "../app/.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"paths": {
			"$db": ["../app/src/db"],
			"$db/*": ["../app/src/db/*"],
			"$lib": ["../app/src/lib"],
			"$lib/*": ["../app/src/lib/*"],
			"$env/static/public": ["./env-stub.d.ts"]
		}
	},
	"include": [
		"./env-stub.d.ts",
		"../app/src/api.ts",
		"../app/src/lib/**/*.ts",
		"../app/src/lib/**/*.svelte.ts"
	]
}
