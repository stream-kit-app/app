{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"paths": {
			"@stream-kit/core": ["./src/index.ts"],
			"#lib/locales/en.json": ["./stubs/locale-en.d.ts"],
			"#lib/locales/nl.json": ["./stubs/locale-nl.d.ts"]
		}
	},
	"include": [
		"./env-stub.d.ts",
		"../app/src/api.ts",
		"../app/src/lib/**/*.ts",
		"../app/src/lib/**/*.svelte.ts",
		"../ui/src/**/*.ts"
	]
}
