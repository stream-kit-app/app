{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-set-size",
		"opener:default",
		"oauth:allow-start",
		"oauth:allow-cancel",
		"store:default",
		"sql:allow-execute",
		"sql:allow-select",
		"sql:allow-load",
		"sql:allow-close",
		"dialog:default",
		"fs:write-all",
		"fs:read-all",
		"fs:allow-create",
		"allow-app-commands",
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "**" }]
		}
	]
}
