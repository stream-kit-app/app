{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Stream Kit",
	"version": "0.1.0-alpha.20",
	"identifier": "app.stream-kit",
	"build": {
		"beforeDevCommand": "pnpm dev:vite",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Stream Kit",
				"width": 300,
				"height": 340,
				"center": true,
				"decorations": false,
				"shadow": true,
				"devtools": true,
				"backgroundColor": "#121319"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"**"
				]
			}
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Stream Kit B.V.",
		"targets": [
			"nsis",
			"msi"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMTA4NkM5RkI1NkMyODEKUldTQndsYjd5WVlRVU9jV0VmT21jWGZHMEZ6RUhlYlRGdTM2RE12dk1QSDgwM1pQQ0hxZUFBdmoK",
			"endpoints": [
				"https://github.com/stream-kit-app/app/releases/download/updater/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
