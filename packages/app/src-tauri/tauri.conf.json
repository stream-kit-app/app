{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Stream Kit",
	"version": "0.1.0-alpha.3",
	"identifier": "app.stream-kit",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Stream Kit",
				"width": 1680,
				"height": 800,
				"devtools": true,
				"backgroundColor": "#0f0f12"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$APPDATA/**"
				]
			}
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Stream Kit B.V.",
		"targets": [
			"nsis",
			"msi",
			"dmg",
			"app"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
