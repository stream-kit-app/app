{
	"name": "@stream-kit/plugin-template",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "tsc --noEmit",
		"dev": "node scripts/build.mjs --watch",
		"package": "pnpm build && node scripts/package.mjs"
	},
	"dependencies": {
		"@stream-kit/core": "workspace:*"
	},
	"devDependencies": {
		"@stream-kit/app": "workspace:*",
		"esbuild": "^0.25.12",
		"tsup": "^8.5.0",
		"typescript": "~6.0.3"
	}
}
