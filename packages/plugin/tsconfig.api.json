{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"resolveJsonModule": true,
		"paths": {
			"@stream-kit/core": ["../core/src/index.ts"],
			"@stream-kit/plugin": ["./src/index.ts"],
			"@stream-kit/plugin/action": ["./stubs/action.d.ts"],
			"@stream-kit/plugin/utils": ["./stubs/utils.d.ts"],
			"#lib/locales/en.json": ["./stubs/locale-en.d.ts"],
			"#lib/locales/nl.json": ["./stubs/locale-nl.d.ts"],
			"$app/env/public": ["./stubs/app-env-public.ts"],
			"$app/env": ["./stubs/app-env.ts"],
			"*.wasm?url": ["./stubs/wasm-url.d.ts"]
		}
	},
	"include": [
		"./env-stub.d.ts",
		"./src/**/*.ts",
		"../app/src/lib/**/*.ts",
		"../app/src/lib/**/*.svelte.ts",
		"../ui/src/**/*.ts"
	]
}
